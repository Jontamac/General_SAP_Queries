CREATE VIEW "CONTAMAC_LIVE"."JG_BoardFinancialReportView_V4" (
    "Account Type",
    "Value",
    "Month"
) AS
WITH "BALANCE_SHEET_RAW" AS (
    SELECT
        T2."FrgnName",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYY') < TO_VARCHAR(CURRENT_DATE, 'YYYY')
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "BF",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '01'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M01",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '02'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M02",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '03'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M03",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '04'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M04",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '05'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M05",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '06'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M06",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '07'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M07",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '08'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M08",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '09'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M09",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '10'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M10",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '11'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M11",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'YYYYMM') <= TO_VARCHAR(CURRENT_DATE, 'YYYY') || '12'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "M12"
    FROM OJDT T0
        INNER JOIN JDT1 T1
            ON T0."TransId" = T1."TransId"
        INNER JOIN OACT T2
            ON T1."Account" = T2."AcctCode"
    WHERE
        LEFT(T2."AcctCode", 1) <= '3'
        AND T2."FrgnName" IS NOT NULL
        AND T2."FrgnName" <> '18 - Payroll Costs'
    GROUP BY T2."FrgnName"),
    "PBT_CUMULATIVE_RAW" AS (
    SELECT
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '01'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum01",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '02'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum02",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '03'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum03",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '04'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum04",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '05'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum05",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '06'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum06",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '07'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum07",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '08'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum08",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '09'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum09",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '10'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum10",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '11'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum11",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '12'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum12"
    FROM OJDT T0
        INNER JOIN JDT1 T1
            ON T0."TransId" = T1."TransId"
        INNER JOIN OACT T2
            ON T1."Account" = T2."AcctCode"
    WHERE TO_VARCHAR(T1."RefDate", 'YYYY') = TO_VARCHAR(CURRENT_DATE, 'YYYY')
        AND (
            LEFT(T2."AcctCode", 1) IN ('4', '5', '6', '7', '8')
            OR UPPER(T2."FrgnName") LIKE '%OTHER INCOME%')),
    "NET_PROFIT_CUMULATIVE_RAW" AS (
    SELECT
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '01'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum01",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '02'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum02",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '03'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum03",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '04'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum04",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '05'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum05",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '06'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum06",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '07'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum07",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '08'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum08",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '09'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum09",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '10'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum10",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '11'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum11",
        SUM(CASE
            WHEN TO_VARCHAR(T1."RefDate", 'MM') <= '12'
            THEN IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)
        END) AS "Cum12"
    FROM OJDT T0
        INNER JOIN JDT1 T1
            ON T0."TransId" = T1."TransId"
        INNER JOIN OACT T2
            ON T1."Account" = T2."AcctCode"
    WHERE TO_VARCHAR(T1."RefDate", 'YYYY') = TO_VARCHAR(CURRENT_DATE, 'YYYY')
        AND (
            LEFT(T2."AcctCode", 1) IN ('4', '5', '6', '7', '8', '9')
            OR UPPER(T2."FrgnName") LIKE '%OTHER INCOME%'))
SELECT
    "FrgnName" AS "Account Type",
    "Value",
    "Month"
FROM ( -- Balance Sheet Balances by month, unpivoted from balance_sheet_raw.
    -- A row is emitted only when that FrgnName has a value for the period (matches
    -- the old behaviour of a query that returns no row when nothing qualifies).
    SELECT
        BS."FrgnName",
        BS."BF" AS "Value",
        'B/F' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."BF" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M01" AS "Value",
        '01' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M01" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M02" AS "Value",
        '02' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M02" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M03" AS "Value",
        '03' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M03" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M04" AS "Value",
        '04' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M04" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M05" AS "Value",
        '05' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M05" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M06" AS "Value",
        '06' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M06" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M07" AS "Value",
        '07' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M07" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M08" AS "Value",
        '08' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M08" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M09" AS "Value",
        '09' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M09" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M10" AS "Value",
        '10' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M10" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M11" AS "Value",
        '11' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M11" IS NOT NULL
    UNION ALL
    SELECT
        BS."FrgnName",
        BS."M12" AS "Value",
        '12' AS "Month"
    FROM balance_sheet_raw BS
    WHERE BS."M12" IS NOT NULL
    UNION ALL
    -- Bring in P&L Monthly Values
    SELECT
        T2."FrgnName",
        -SUM(IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)) AS "Value",
        TO_VARCHAR(T1."RefDate", 'MM') AS "Month"
    FROM OJDT T0
        INNER JOIN JDT1 T1
            ON T0."TransId" = T1."TransId"
        INNER JOIN OACT T2
            ON T1."Account" = T2."AcctCode"
    WHERE TO_VARCHAR(T1."RefDate", 'YYYY') = TO_VARCHAR(CURRENT_DATE, 'YYYY')
        AND LEFT(T2."AcctCode", 1) >= '4'
        AND T2."FrgnName" IS NOT NULL
    GROUP BY T2."FrgnName", TO_VARCHAR(T1."RefDate", 'MM')
    UNION ALL
    -- Bring in Payroll Costs - for each month
    SELECT
        T2."FrgnName",
        -SUM(IFNULL(T1."Credit", 0)) AS "Value",
        TO_VARCHAR(T1."RefDate", 'MM') AS "Month"
    FROM OJDT T0
        INNER JOIN JDT1 T1
            ON T0."TransId" = T1."TransId"
        INNER JOIN OACT T2
            ON T1."Account" = T2."AcctCode"
    WHERE T2."FrgnName" = '18 - Payroll Costs'
        AND TO_VARCHAR(T1."RefDate", 'YYYY') = TO_VARCHAR(CURRENT_DATE, 'YYYY')
    GROUP BY T2."FrgnName", TO_VARCHAR(T1."RefDate", 'MM')
    UNION ALL
    -- Credit Card Costs for each month
    SELECT
        '21 - Credit Card' AS "FrgnName",
        SUM(T0."DocTotal") AS "Value",
        TO_VARCHAR(T0."DocDate", 'MM') AS "Month"
    FROM OPCH T0
    WHERE T0."CardName" LIKE 'CREDIT CARD%'
        AND TO_VARCHAR(T0."DocDate", 'YYYY') = TO_VARCHAR(CURRENT_DATE, 'YYYY')
    GROUP BY TO_VARCHAR(T0."DocDate", 'MM')
    UNION ALL
    -- Bring in total Income
    SELECT
        '26 - Total Income' AS "FrgnName",
        -SUM(IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)) AS "Value",
        TO_VARCHAR(T1."RefDate", 'MM') AS "Month"
    FROM OJDT T0
        INNER JOIN JDT1 T1
            ON T0."TransId" = T1."TransId"
        INNER JOIN OACT T2
            ON T1."Account" = T2."AcctCode"
    WHERE TO_VARCHAR(T1."RefDate", 'YYYY') = TO_VARCHAR(CURRENT_DATE, 'YYYY')
        AND (
            LEFT(T2."FrgnName", 2) IN ('23', '24', '25')
            OR UPPER(T2."FrgnName") LIKE '%OTHER INCOME%')
    GROUP BY TO_VARCHAR(T1."RefDate", 'MM')
    UNION ALL
    -- Gross Profit
    SELECT
        '27 - Gross Profit' AS "FrgnName",
        -SUM(IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)) AS "Value",
        TO_VARCHAR(T1."RefDate", 'MM') AS "Month"
    FROM OJDT T0
        INNER JOIN JDT1 T1
            ON T0."TransId" = T1."TransId"
        INNER JOIN OACT T2
            ON T1."Account" = T2."AcctCode"
    WHERE TO_VARCHAR(T1."RefDate", 'YYYY') = TO_VARCHAR(CURRENT_DATE, 'YYYY')
        AND LEFT(T2."AcctCode", 1) IN ('4', '5')
    GROUP BY TO_VARCHAR(T1."RefDate", 'MM')
    UNION ALL
    -- Profit Before Tax (non-cumulative monthly figure)
    SELECT
        '30 - Profit Before Tax' AS "FrgnName",
        -SUM(IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)) AS "Value",
        TO_VARCHAR(T1."RefDate", 'MM') AS "Month"
    FROM OJDT T0
        INNER JOIN JDT1 T1
            ON T0."TransId" = T1."TransId"
        INNER JOIN OACT T2
            ON T1."Account" = T2."AcctCode"
    WHERE TO_VARCHAR(T1."RefDate", 'YYYY') = TO_VARCHAR(CURRENT_DATE, 'YYYY')
        AND (
            LEFT(T2."AcctCode", 1) IN ('4', '5', '6', '7', '8')
            OR UPPER(T2."FrgnName") LIKE '%OTHER INCOME%')
    GROUP BY TO_VARCHAR(T1."RefDate", 'MM')
    UNION ALL
    -- Profit Before Tax Cumulative, unpivoted from pbt_cumulative_raw
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum01" AS "Value",
        '01' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum02" AS "Value",
        '02' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum03" AS "Value",
        '03' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum04" AS "Value",
        '04' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum05" AS "Value",
        '05' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum06" AS "Value",
        '06' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum07" AS "Value",
        '07' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum08" AS "Value",
        '08' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum09" AS "Value",
        '09' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum10" AS "Value",
        '10' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum11" AS "Value",
        '11' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    SELECT
        '31 - Profit Before Tax Cumulative' AS "FrgnName",
        -PC."Cum12" AS "Value",
        '12' AS "Month"
    FROM pbt_cumulative_raw PC
    UNION ALL
    -- Net Profit (non-cumulative monthly figure)
    SELECT
        '32 - Net Profit' AS "FrgnName",
        -SUM(IFNULL(T1."Debit", 0) - IFNULL(T1."Credit", 0)) AS "Value",
        TO_VARCHAR(T1."RefDate", 'MM') AS "Month"
    FROM OJDT T0
        INNER JOIN JDT1 T1
            ON T0."TransId" = T1."TransId"
        INNER JOIN OACT T2
            ON T1."Account" = T2."AcctCode"
    WHERE TO_VARCHAR(T1."RefDate", 'YYYY') = TO_VARCHAR(CURRENT_DATE, 'YYYY')
        AND (
            LEFT(T2."AcctCode", 1) IN ('4', '5', '6', '7', '8', '9')
            OR UPPER(T2."FrgnName") LIKE '%OTHER INCOME%')
    GROUP BY TO_VARCHAR(T1."RefDate", 'MM')
    UNION ALL
    -- Net Profit Cumulative, unpivoted from net_profit_cumulative_raw
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum01" AS "Value",
        '01' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum02" AS "Value",
        '02' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum03" AS "Value",
        '03' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum04" AS "Value",
        '04' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum05" AS "Value",
        '05' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum06" AS "Value",
        '06' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum07" AS "Value",
        '07' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum08" AS "Value",
        '08' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum09" AS "Value",
        '09' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum10" AS "Value",
        '10' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum11" AS "Value",
        '11' AS "Month"
    FROM net_profit_cumulative_raw NC
    UNION ALL
    SELECT
        '33 - Net Profit Cumulative' AS "FrgnName",
        -NC."Cum12" AS "Value",
        '12' AS "Month"
    FROM net_profit_cumulative_raw NC)
ORDER BY "FrgnName",
    "Month" WITH READ ONLY